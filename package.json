{
  "name": "@qavajs/playwright",
  "version": "4.3.0",
  "description": "steps to interact with playwright",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./steps.js": "./steps.js",
    "./lib/electron.js": "./lib/electron.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "steps.js",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "prepublishOnly": "npm run build",
    "lint": "oxlint --type-aware src test",
    "test:unit": "node --import tsx --test \"test/unit/**/*.test.ts\"",
    "start:server": "tsx test-e2e/support/server.ts",
    "install:browsers": "playwright install",
    "debug:e2e": "playwright test --config test-e2e/playwright.config.ts --ui",
    "debug:e2e:electron": "playwright test --config test-e2e/playwright.electron.config.ts --ui",
    "test:e2e": "playwright test --config test-e2e/playwright.e2e.config.ts",
    "test:e2e:electron": "playwright test --config test-e2e/playwright.electron.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qavajs/playwright.git"
  },
  "authors": [
    "Alexandr Galichenko"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qavajs/playwright/issues"
  },
  "homepage": "https://github.com/qavajs/playwright#readme",
  "devDependencies": {
    "@cucumber/cucumber-expressions": "^20.1.0",
    "@qavajs/playwright-console-reporter": "^0.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "express": "^5.3.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@playwright/test": "^1.64.1",
    "@qavajs/memory": "^1.11.0",
    "@qavajs/playwright-runner-adapter": "^2.3.3"
  }
}
